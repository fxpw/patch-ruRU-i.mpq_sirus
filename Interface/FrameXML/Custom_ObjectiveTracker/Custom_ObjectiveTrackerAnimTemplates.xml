<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
	<Frame name="ObjectiveTrackerAnimLineTemplate" inherits="ObjectiveTrackerLineTemplate" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" parentKey="Icon" hidden="true">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="-10" y="2"/>
					</Anchors>
					<Animations>
						<AnimationGroup parentKey="CheckAnim">
							<Alpha duration="0" order="1" change="-1"/>
							<Scale duration="0.15" order="2" smoothing="OUT" scaleX="1.2" scaleY="1.2"/>
							<Scale duration="0.15" order="2" startDelay="0.15" smoothing="OUT" scaleX="0.833333" scaleY="0.833333"/>
							<Alpha duration="0.15" order="2" change="1"/>
						</AnimationGroup>
					</Animations>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="CheckGlow" alpha="0">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentIcon"/>
					</Anchors>
					<Animations>
						<AnimationGroup parentKey="CheckAnim">
							<Alpha duration="0.15" order="1" change="1"/>
							<Alpha duration="0.15" order="1" startDelay="0.15" change="-1"/>
							<Scale duration="0.15" order="1" scaleX="1.2" scaleY="1.2"/>
							<Scale duration="0.15" order="1" startDelay="0.15" scaleX="0.833333" scaleY="0.833333"/>
						</AnimationGroup>
					</Animations>
				</Texture>
				<Texture parentKey="Glow" alpha="0">
					<Size x="180" y="0"/>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentText" x="-2" y="0"/>
						<Anchor point="TOP" x="0" y="0"/>
						<Anchor point="BOTTOM" x="0" y="-4"/>
					</Anchors>
					<Animations>
						<AnimationGroup parentKey="GlowAnim">
							<Scale duration="0" order="1" scaleX="0.001" scaleY="1">
								<Origin point="LEFT"/>
							</Scale>
							<Alpha duration="0" order="1" change="1"/>
							<Scale duration="0.66" order="2" startDelay="0.1" smoothing="OUT" scaleX="1000" scaleY="1">
								<Origin point="LEFT"/>
							</Scale>
							<Alpha duration="0.58" order="2" startDelay="0.33" change="-1"/>
						</AnimationGroup>
					</Animations>
				</Texture>
			</Layer>
		</Layers>
		<Animations>
			<AnimationGroup parentKey="CheckAnim">
				<Alpha duration="0.30" order="1"/>
				<Scripts>
					<OnPlay>
						local parent = self:GetParent()
						parent.Icon.CheckAnim:Play()
						parent.CheckGlow.CheckAnim:Play()
					</OnPlay>
					<OnStop>
						local parent = self:GetParent()
						if parent.Icon.CheckAnim:IsPlaying() then
							parent.Icon.CheckAnim:Stop()
						end
						if parent.CheckGlow.CheckAnim:IsPlaying() then
							parent.CheckGlow.CheckAnim:Stop()
						end
					</OnStop>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="GlowAnim">
				<Alpha duration="0.92" order="1"/>
				<Scripts>
					<OnPlay>
						local parent = self:GetParent()
						parent.Glow.GlowAnim:Play()
					</OnPlay>
					<OnStop>
						local parent = self:GetParent()
						if parent.Glow.GlowAnim:IsPlaying() then
							parent.Glow.GlowAnim:Stop()
						end
					</OnStop>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="FadeOutAnim">
				<Alpha startDelay="1" change="-1" duration="0.1" order="1"/>
			</AnimationGroup>
			<AnimationGroup parentKey="FadeInAnim">
				<Alpha parentKey="Alpha" change="-1" duration="0" order="1"/>
				<Alpha parentKey="Alpha" change="1" duration="0.5" order="2"/>
			</AnimationGroup>
		</Animations>
		<Scripts>
			<OnLoad>
				Mixin(self, ObjectiveTrackerAnimLineMixin)
				self:OnLoad()
			</OnLoad>
		</Scripts>
	</Frame>

	<Frame name="ObjectiveTrackerAnimBlockTemplate" inherits="ObjectiveTrackerBlockTemplate" hidden="true" virtual="true">
		<Size x="240" y="0"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="HeaderGlow" alpha="0">
					<Size x="240" y="0"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentHeaderText" y="3"/>
						<Anchor point="BOTTOMLEFT" relativeTo="$parentHeaderText" y="-4"/>
					</Anchors>
					<Animations>
						<AnimationGroup parentKey="AddAnim">
							<Scale duration="0" order="1" scaleX="0.001" scaleY="1">
								<Origin point="LEFT"/>
							</Scale>
							<Scale duration="0.31" order="2" startDelay="0.15" scaleX="1000" scaleY="1">
								<Origin point="LEFT"/>
							</Scale>
							<Alpha duration="0" order="1" change="1"/>
							<Alpha duration="0.41" order="2" startDelay="0.33" change="-1"/>
						</AnimationGroup>
						<AnimationGroup parentKey="TurnInAnim">
							<Scale duration="0" order="1" scaleX="0.001" scaleY="1">
								<Origin point="LEFT"/>
							</Scale>
							<Alpha duration="0" order="1" change="1"/>
							<Scale duration="0.51" order="2" scaleX="1000" scaleY="1">
								<Origin point="LEFT"/>
							</Scale>
							<Alpha duration="0.33" order="2" startDelay="0.33" change="-1"/>
						</AnimationGroup>
						<AnimationGroup parentKey="RemoveAnim">
							<Alpha parentKey="Alpha" change="-1" duration="0.5" startDelay="3.5" order="1"/>
						</AnimationGroup>
					</Animations>
				</Texture>
			</Layer>
		</Layers>
		<Animations>
			<AnimationGroup parentKey="AddAnim">
				<Alpha duration="0.74" order="1"/>
				<Scripts>
					<OnPlay>
						local parent = self:GetParent()
						parent.HeaderGlow.AddAnim:Play()
						parent.HeaderText.AddAnim:Play()
					</OnPlay>
					<OnStop>
						local parent = self:GetParent()
						if parent.HeaderGlow.AddAnim:IsPlaying() then
							parent.HeaderGlow.AddAnim:Stop()
						end
						if parent.HeaderText.AddAnim:IsPlaying() then
							parent.HeaderText.AddAnim:Stop()
						end
						parent:OnAnimStopped()
					</OnStop>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="TurnInAnim">
				<Alpha duration="0.66" order="1"/>
				<Scripts>
					<OnPlay>
						local parent = self:GetParent()
						parent.HeaderGlow.TurnInAnim:Play()
					</OnPlay>
					<OnStop>
						local parent = self:GetParent()
						if parent.HeaderGlow.TurnInAnim:IsPlaying() then
							parent.HeaderGlow.TurnInAnim:Stop()
						end
						parent:OnAnimStopped()
					</OnStop>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="RemoveAnim">
				<Alpha duration="4" order="1"/>
				<Scripts>
					<OnPlay>
						local parent = self:GetParent()
						parent.HeaderText.RemoveAnim:Play()
					</OnPlay>
					<OnStop>
						local parent = self:GetParent()
						if parent.HeaderText.RemoveAnim:IsPlaying() then
							parent.HeaderText.RemoveAnim:Stop()
						end
						parent:OnAnimStopped()
					</OnStop>
				</Scripts>
			</AnimationGroup>
		</Animations>
		<Scripts>
			<OnLoad>
				Mixin(self, ObjectiveTrackerAnimBlockMixin)
				self:OnLoad()
			</OnLoad>
		</Scripts>
	</Frame>
</Ui>
